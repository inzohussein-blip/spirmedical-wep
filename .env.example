# ════════════════════════════════════════════════════════════════════
# 🔐 متغيّرات البيئة — Spir Medical
# ════════════════════════════════════════════════════════════════════
#
# المصدر الموثوق للتحقّق هو `src/lib/env.ts` (مخطّط zod).
# هذا الملف يجب أن يبقى مطابقاً له — يحرسه `tests/env-coverage.test.ts`.
#
# ⚠️ الأسرار الاختيارية ليست «غير مهمّة»: غيابها لا يُفشل البناء بل
# يُعطّل ميزةً **بصمت**. الأثر مذكور بجانب كلٍّ منها.
# ════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────
# 🔴 مطلوبة — البناء يفشل بدونها
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة — يتجاوز RLS. لا يُكشف للمتصفّح أبداً.
SUPABASE_SERVICE_ROLE_KEY=

# تشفير الملاحظات الطبّية — 64 حرفاً hex (32 بايت)
# توليد: openssl rand -hex 32
ENCRYPTION_KEY=


# ─────────────────────────────────────────────────────────
# 🌐 الموقع والتوجيه
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://spir-medical.com

# يُستعمل في روابط تفعيل البريد واستعادة كلمة المرور.
# عند غيابه تسقط الروابط إلى NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_APP_URL=https://spir-medical.com

# ⚠️ الفصل بين التطبيق والتسويق يعمل **بنطاقين مختلفين فقط**.
# لو ساوى APP_URL فضبط SITE_TYPE='app' يُنتج حلقة تحويل لا نهائية
# على مسارات التسويق (/about, /faq …). اتركه 'all' على نطاق واحد.
NEXT_PUBLIC_MARKETING_URL=https://spir-medical.com
NEXT_PUBLIC_SITE_TYPE=all

NEXT_PUBLIC_APP_VERSION=


# ─────────────────────────────────────────────────────────
# 🔐 المصادقة
# ─────────────────────────────────────────────────────────

# أوضاع OTP:
#   required → إجباري (الأكثر أماناً — يُقفل الدخول بلا رمز)
#   optional → المستخدم يختار (الافتراضي الحالي)
#   disabled → بلا OTP (تطوير فقط)
#
# 🚨 في وضع optional/disabled يكون «الدخول بالهاتف بلا رمز» مسموحاً:
# من يعرف رقم الهاتف يدخل الحساب. اضبطه required فور تفعيل قناة OTP.
NEXT_PUBLIC_OTP_MODE=optional

# تجاوز صريح للقاعدة أعلاه — لا تضبطه 'true' في الإنتاج.
ALLOW_PASSWORDLESS_LOGIN=false

# سرّ اشتقاق كلمات سرّ حسابات الهاتف (32 حرفاً فأكثر).
# عند غيابه يسقط النظام إلى ENCRYPTION_KEY (توافق رجعي).
AUTH_PASSWORD_SECRET=


# ─────────────────────────────────────────────────────────
# 👑 بوّابة الإدارة
# ─────────────────────────────────────────────────────────

# مفتاح إنشاء حساب أدمن — بدونه يُغلق مسار الإنشاء.
ADMIN_CREATE_KEY=

# قائمة بريد مسموح لها بطلب صلاحية الأدمن (مفصولة بفواصل).
ADMIN_ALLOWED_EMAILS=

# بريد المالك — تصله إشعارات طلبات الأدمن.
ADMIN_OWNER_EMAIL=


# ─────────────────────────────────────────────────────────
# ⏰ المهامّ المجدولة (Vercel Cron)
# ─────────────────────────────────────────────────────────

# 🚨 بدونه تفشل **كل** المهامّ المجدولة مغلقة (fail-closed) — أي أنّ
# تذكيرات المواعيد والطلبات الدورية ومعالجة طابور الإشعارات
# **لا تعمل بصمت**، بلا خطأ ظاهر. 16 حرفاً فأكثر.
CRON_SECRET=


# ─────────────────────────────────────────────────────────
# 💬 واتساب / OTP
# ─────────────────────────────────────────────────────────

# meta | twilio | mock  (الافتراضي mock = لا إرسال فعلي)
WHATSAPP_PROVIDER=mock

# ── Meta WhatsApp Cloud API ──
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0
# توقيع webhook — بدونه تُرفض كل ردود التسليم بـ401.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ── أسماء قديمة (احتياط توافقي) ──
# المسارَان يقرآن `META_*` أوّلاً ثمّ هذه. لا حاجة لضبطها في تثبيت جديد؛
# تُترك لتوافق نشرٍ قديم كان يستعملها.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=

# ── Twilio (بديل — يُستعمل فقط مع WHATSAPP_PROVIDER=twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# قناة Telegram في واجهة OTP
NEXT_PUBLIC_ENABLE_TELEGRAM_OTP=false


# ─────────────────────────────────────────────────────────
# 🔔 إشعارات الدفع (Web Push / VAPID)
# ─────────────────────────────────────────────────────────
# بدونها تُعطَّل إشعارات الدفع كلّياً — بلا خطأ، مجرّد صمت.
# توليد: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@spir-medical.com


# ─────────────────────────────────────────────────────────
# 📧 البريد (Resend)
# ─────────────────────────────────────────────────────────
# بدونه لا تحقّق بريد ولا استعادة كلمة مرور.

RESEND_API_KEY=
RESEND_FROM_EMAIL=Spir Medical <no-reply@spir-medical.com>
# 'true' يطبع البريد في السجلّ بدل إرساله (تطوير)
RESEND_DEV=false


# ─────────────────────────────────────────────────────────
# 📊 المراقبة والتحليلات (اختيارية بالكامل)
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# اسم بديل يقرؤه الكود قبل الاسم أعلاه (نشرٌ قديم)
NEXT_PUBLIC_spirmedical_SENTRY_DSN=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# debug | info | warn | error
LOG_LEVEL=info


# ─────────────────────────────────────────────────────────
# 🚦 تحديد المعدّل الموزّع (Upstash Redis — اختياري)
# ─────────────────────────────────────────────────────────
# بدونه يعمل تحديد المعدّل على قاعدة البيانات.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─────────────────────────────────────────────────────────
# 🎛️ مفاتيح الميزات
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_ENABLE_SPECIALIST_CHAT=false
NEXT_PUBLIC_ENABLE_FAMILY_ACCOUNTS=false
NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=false
