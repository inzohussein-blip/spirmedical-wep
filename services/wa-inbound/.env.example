# عنوان الموقع — بـwww: النطاقُ العاري يحوّل (308) فيسقط جسمُ الطلب
SITE_URL=https://www.spir-medical.com
# السرّ المشترك مع الموقع (نفس WA_INBOUND_SECRET في Vercel) — 32 حرفاً أو أكثر
#   ولّده بـ: openssl rand -hex 32
WA_INBOUND_SECRET=
# يحمي صفحة رمز QR: https://<خدمتك>.up.railway.app/qr?token=<ADMIN_TOKEN>
ADMIN_TOKEN=
# مجلد الجلسة على القرص الدائم
AUTH_DIR=/data/auth
# 1 = المرحلة 0 (تجربة): لا يُرسَل شيءٌ للموقع، يُقاس فقط هل يصل رقمُ المرسِل
PROBE_ONLY=1
